{#
  Reusable SVG displacement filter: feImage loads an image and
  feDisplacementMap warps the filtered element's pixels by that image's colour
  channels, so text picks up the texture of a photograph.

  Usage:
    {% from "displace-filter.njk" import displaceFilter %}
    {{ displaceFilter("my-filter-id", "/public/some/image.jpg") }}
    {{ displaceFilter("my-filter-id", src, scale=4, aspect="xMidYMid slice") }}

  then reference it from CSS with `filter: url(#my-filter-id)`.

  Filter-primitive coords are in the element's CSS pixels (the default
  userSpaceOnUse), so with "xMidYMin slice" only the top band of the image —
  as tall as the filtered element — is sampled. The feImage and
  feDisplacementMap carry `data-displace-image` / `data-displace-map` so a
  script can swap the image or retune the scale at runtime.
#}
{% macro displaceFilter(id, href, scale=0, xChannel="B", yChannel="G", aspect="xMidYMin slice") %}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <filter id="{{ id }}" x="-8%" y="-8%" width="116%" height="116%" color-interpolation-filters="sRGB">
    <feImage data-displace-image href="{{ href }}" x="0" y="0" width="100%" height="100%" preserveAspectRatio="{{ aspect }}" result="displacementImage"/>
    <feDisplacementMap data-displace-map in="SourceGraphic" in2="displacementImage" scale="{{ scale }}" xChannelSelector="{{ xChannel }}" yChannelSelector="{{ yChannel }}"/>
  </filter>
</svg>
{%- endmacro %}
